FROM node:22-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global @openai/codex

ENV HOME=/codex-home
EXPOSE 8765/tcp

ENTRYPOINT ["codex"]
CMD ["app-server", "--listen", "ws://0.0.0.0:8765"]
